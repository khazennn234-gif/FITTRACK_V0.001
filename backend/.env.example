# ==============================================================================
# FitTrack Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
# Mode SQLite (Default Zero-config untuk Local Development):
DATABASE_URL="file:./dev.db"

# Mode PostgreSQL (Opsional untuk Production Supabase / Neon / Railway):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fittrack?schema=public"

# Authentication Secrets (Ganti dengan string random aman di production)
JWT_SECRET="fittrack_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="fittrack_jwt_refresh_secret_super_secure_key_2026"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# CORS Configuration (Dipisahkan koma untuk multi origin)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
